{
  "name": "arabic-subs",
  "version": "2.4.0",
  "description": "Arabic Subs - offline on-device EN to AR subtitle engine powered by Hy-MT2 (llama.cpp), ffmpeg and whisper.cpp",
  "main": "src/pipeline.js",
  "bin": {
    "arabic-subs": "bin/arabic-subs.js"
  },
  "scripts": {
    "start": "node bin/arabic-subs.js run --media /sdcard/Movies",
    "setup": "node bin/arabic-subs.js setup",
    "test": "node --test",
    "verify:engine": "node scripts/verify-engine-libs.mjs",
    "fetch:node-libs": "node scripts/fetch-node-libs.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "subtitles",
    "arabic",
    "translation",
    "hy-mt2",
    "llama.cpp",
    "whisper",
    "ffmpeg"
  ],
  "author": "muxd22-alt",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {}
}
