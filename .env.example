# Arabic Subs — optional configuration.
# Copy to `.env` (which is git-ignored) and fill in what you have.
# Everything here is free; nothing is required.

# ── The subtitle bazaar ──────────────────────────────────────────────────────
# 0 = never look for existing subtitles online (local sidecars + whisper only)
# ARABIC_SUBS_PROVIDERS=1

# Languages to ask providers for, in order. Arabic first = brand it as-is,
# the rest are translation sources.
# PROVIDER_LANGUAGES=ar,en,es

# Per-provider search timeout and how many downloads to try per video.
# PROVIDER_TIMEOUT_MS=15000
# PROVIDER_MAX_TRIES=6

# Free IMDb id lookup (no key, no account) — 0 turns it off.
# PROVIDER_RESOLVE_IMDB=1

# 0 = do not read subtitle tracks stored inside the video file.
# PROVIDER_EMBEDDED=1

# subdl.com — free API key: subdl.com → profile → API
# SUBDL_API_KEY=

# opensubtitles.com — free key (profile page) plus a free account for downloads
# OPENSUBTITLES_API_KEY=
# OPENSUBTITLES_USERNAME=
# OPENSUBTITLES_PASSWORD=

# ── Engine (usually not needed) ──────────────────────────────────────────────
# HYMT_MODEL_FLAVOR=q4_k_m     # q4_k_m (default), q6_k, q8_0, stq
# LLAMA_PORT=18434
# STATUS_PORT=8799
# TRANSLATE_CONCURRENCY=4
# TRANSLATE_BATCH_LINES=16
# WHISPER_MODEL=base           # tiny / base / small
# THREADS=0                    # 0 = auto
