# SubArabify configuration — copy to .env and fill in.
# Free keys: https://www.opensubtitles.com/en/users/sign_up (API consumer key),
# https://www.themoviedb.org/settings/api (TMDB v3 key).

# OpenSubtitles.com consumer API key — enables hash/title subtitle search.
OPENSUBTITLES_API_KEY=

# Optional: OpenSubtitles account credentials. Not required for search;
# enabling them unlocks the download quota (JWT) and per-user quota reporting.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# TMDB API key — used by the genre-aware movie brief (wired in the next module).
TMDB_API_KEY=

# Where per-movie decisions are appended as JSONL (default: logs/decisions.jsonl)
#SUBARABIFY_DECISION_LOG=/path/to/decisions.jsonl
